
require "sha256_constants.jinc"

// initialise the intermediate hash values (IHVs)
inline fn __init_ihv() -> stack u32[8] {
  stack u32[8] ihv;
  
  // copy the values from the sha256_constants file
  inline int i;
  for i=0 to 8 {
    ihv[i] = SHA256_ihv[i];
  }
  
  return ihv;
}

// sigma_0 fuction for confuscating words for the message schedule
inline fn __sigma_0(reg u32 w) -> reg u32 {
  // compute the two right rotations and the right shift
  reg u32 w1 w2;
  w1 = w;
  w2 = w;
  w  >>r= 7;  // w rot 7
  w1 >>r= 18; // w rot 18
  w2 >>=  3;  // w >>  3
  
  w ^= w1;    // (w rot 7) ^ (w rot 18)
  w ^= w2;    // (w rot 7) ^ (w rot 18) ^ (w >> 3)

  return w;   // (w rot 7) ^ (w rot 18) ^ (w >> 3)
}

// sigma_1 fuction for confuscating words for the message schedule
inline fn __sigma_1(reg u32 w) -> reg u32 {
  // compute the two right rotations and the right shift
  reg u32 w1 w2;
  w1 = w;
  w2 = w;
  w  >>r= 17; // w rot 17
  w1 >>r= 19; // w rot 19
  w2 >>=  10; // w >>  10
  
  w ^= w1;    // (w rot 17) ^ (w rot 19)
  w ^= w2;    // (w rot 17) ^ (w rot 19) ^ (w >> 10)

  return w;   // (w rot 17) ^ (w rot 19) ^ (w >> 10)
}

// compute the next word for the message schedule
inline fn __f_word(stack u32 stack_w_i w_i2 w_i7 w_i15 w_i16) -> stack u32 {
  reg u32 w_i temp;
  temp = w_i15;
  temp = __sigma_0(temp);

  w_i  = w_i2;           // w_{i-2}
  w_i  = __sigma_1(w_i); // sigma_1(w_{i-2})
  w_i += w_i7;           // sigma_1(w_{i-2}) + w_{i-7}
  w_i += temp;           // sigma_1(w_{i-2}) + w_{i-7} + sigma_0(w_{i-15})
  w_i += w_i16;          // sigma_1(w_{i-2}) + w_{i-7} + sigma_0(w_{i-15}) + w_{i-16}

  stack_w_i = w_i;
  return stack_w_i;      // sigma_1(w_{i-2}) + w_{i-7} + sigma_0(w_{i-15}) + w_{i-16}
}

// take a message block and produce a message schedule from it
inline fn __f_sch(stack u32[64] sch, stack u32[16] block) -> stack u32[64] {
  // copy the message block into the first 16 words
  inline int i;
  for i=0 to 16 {
    sch[i] = block[i];
  }

  // compute the rest of the words in the message schedule
  for i=16 to 64 {
    sch[i] = __f_word(sch[i], sch[i-2], sch[i-7], sch[i-15], sch[i-16]);
  }

  return sch; // return the entire message schedule
}

// Sigma_0 fuction for confuscating words in the main loop
inline fn __Sigma_0(reg u32 w) -> reg u32 {
  // compute the three right rotations
  reg u32 w1 w2 w3;
  w1 = w; w2 = w; w3 = w;

  w1 >>r= 2;  // w rot 2
  w2 >>r= 13; // w rot 13
  w3 >>r= 22; // w rot 22
  
  w  = w1;
  w ^= w2;    // (w rot 2) ^ (w rot 13)
  w ^= w3;    // (w rot 2) ^ (w rot 13) ^ (w rot 22)

  return w;   // (w rot 2) ^ (w rot 13) ^ (w rot 22)
}

// Sigma_1 fuction for confuscating words in the main loop
inline fn __Sigma_1(reg u32 w) -> reg u32 {
  // compute the three right rotations
  reg u32 w1 w2 w3;
  w1 = w; w2 = w; w3 = w;

  w1 >>r= 6;  // w rot 6
  w2 >>r= 11; // w rot 11
  w3 >>r= 25; // w rot 25
  
  w  = w1;
  w ^= w2;                    // (w rot 6) ^ (w rot 11)
  w ^= w3;                    // (w rot 6) ^ (w rot 11) ^ (w rot 25)

  return w;                   // (w rot 6) ^ (w rot 11) ^ (w rot 25)
}

// majority function that computes the bitwise majority of three words
inline fn __f_maj(reg u32 x y z) -> reg u32 {
  reg u32 t u;

  t  = x; // t = x
  t &= z; // t = (x & z)
  u  = x;
  u &= y; // x = (x & y)
  u ^= t; // x = (x & y) ^ (x & z)
  t  = y; // t = y
  t &= z; // t = (y & z)
  x  = u;
  x ^= t; // x = (x & y) ^ (x & z) ^ (y & z)

  return x; // (x & y) ^ (x & z) ^ (y & z)
}

// choice function that selects the bits from y and z based on the bits in x
inline fn __f_cho(reg u32 x y z) -> reg u32 {
  reg u32 t u;

  t  =  x; // t = x
  t  = !t; // t = !x
  t &=  z; // t = (!x & z)
  u  =  x;
  u &=  y; // x = (x & y)
  x  =  u;
  x ^=  t; // x = (x & y) ^ (!x & z)

  return x; // (x & y) ^ (!x & z)
}

// round function that takes the working variables and updates them
inline fn __f_rou(reg u32[8] t, stack u32 w_i k_i) -> reg u32[8] {
  reg u32 t_1 t_2 fun;

  // compute t_1
  t_1  = t[7];                     // t_1 = t_h
  t_1 += w_i;                      // t_1 = t_h + w_i
  t_1 += k_i;                      // t_1 = t_h + w_i + k_i
  fun = __f_cho(t[4], t[5], t[6]); // fun = f_cho(t_e, t_f, t_g)
  t_1 += fun;                      // t_1 = t_h + w_i + k_i + f_cho(t_e, t_f, t_g)
  fun = __Sigma_1(t[4]);           // fun = Sigma_1(t_e)
  t_1 += fun;                      // t_1 = t_h + w_i + k_i + f_cho(t_e, t_f, t_g) + Sigma_1(t_e)

  // compute t_2
  fun = __f_maj(t[0], t[1], t[2]); // fun = f_maj(t_a, t_b, t_c)
  t_2 = fun;                       // t_2 = f_maj(t_a, t_b, t_c)
  fun = __Sigma_0(t[0]);           // fun = Sigma_0(t_a)
  t_2 += fun;                      // t_2 = f_maj(t_a, t_b, t_c) + Sigma_0(t_a)

  // update the working variables
  t[7] = t[6];              // t_h = t_g
  t[6] = t[5];              // t_g = t_f
  t[5] = t[4];              // t_f = t_e
  t[4] = t[3]; t[4] += t_1; // t_e = t_d + t_1
  t[3] = t[2];              // t_d = t_c
  t[2] = t[1];              // t_c = t_b
  t[1] = t[0];              // t_b = t_a
  t[0] = t_1;  t[0] += t_2; // t_a = t_1 + t_2

  return t;
}

// main loop that takes and updates the IHVs through iterated calls of the round function
inline fn __f_loop(stack u32[8] ihv, stack u32[64] sch) -> stack u32[8] {
  reg u32[8]    t; // working variables
  stack u32[64] k; // loop constants
  k = SHA256_k;

  // copy the IHVs into the working variables
  inline int j;
  for j=0 to 8 {
    t[j] = ihv[j];
  }

  // run the round function 64 times on the working variables
  inline int i;
  for i=0 to 64 {
    t = __f_rou(t, sch[i], k[i]);
  }

  // add the working variables to the IHVs
  for j=0 to 8 {
    t[j] += ihv[j];
    ihv[j] = t[j];
  }

  return ihv; // return the updated IHVs
}

// word-swap every word in the block to correct for Little Endianness
inline fn __swap_block(stack u32[16] block) -> stack u32[16] {
  inline int j;
  reg u32 swap;
  for j=0 to 16 {
    swap = block[u32 (int) j];
    swap = #BSWAP_32(swap);
    block[u32 (int) j] = swap;
  }

  return block;
}

// construct message blocks and process them
inline fn __f_comp(stack u32[8] ihv, reg u64 mess_addr nr_raw_bytes) -> stack u32[8] {
  stack u32[16] block; // message block
  stack u32[64] sch;   // message schedule
  stack u64 bytes_st;
  bytes_st = nr_raw_bytes; // save the original message length for the length encoding
  
  reg u64 byte_index;
  byte_index = 0;
  // process all blocks consisting fully of message bytes
  while (nr_raw_bytes >= 64) {
    // copy the next block of the message word by word
    inline int j;
    for j=0 to 16 {
      block[j] = (u32)[mess_addr + byte_index + 4*j];
    }

    // process the block
    block = __swap_block(block); // swap every word to correct for Little Endianness
    sch = __f_sch(sch, block);   // compute the message schedule
    ihv = __f_loop(ihv, sch);    // run the main loop and update the IHVs

    // 64 bytes of message have been processed,
    nr_raw_bytes -= 64; // so decrement the remaining number of bytes to process,
    byte_index += 64;   // and update the byte index to the next block in memory
  }

  // all message blocks consisting fully of message bytes have been processed,
  // now there are < 64 bytes left to process, and the padding has to be done

  // the message bytes and the separator byte are guarnateed to fit in the next block
  // (<64 + 1 <= 64)

  // copy the remaining message bytes one byte at a time
  reg u64 i;
  i = 0;
  while (i < nr_raw_bytes) {
    block[u8 (int) i] = (u8)[mess_addr + byte_index];
    byte_index += 1;
    i += 1;
  }

  // set the separator bit
  block[u8 (int) i] = 0x80; // 0x80 = 0b10000000
  i += 1;

  // check if adding padding requires an extra block:
  // need one byte for the separator bit and need eight bytes for the length encoding
  // so at most 64-1-8 = 55 bytes left for the message
  if (nr_raw_bytes > 55) {
    // the remaining message bytes and padding do not both fit in the current block
    // so fill the current block to the end with zero-padding
    while (i < 64) {
      block[u8 (int) i] = 0x0;
      i += 1;
    }
    i = 0; // reset the index to 0 for the next block

    // process the block
    block = __swap_block(block); // swap every word to correct for Little Endianness
    sch = __f_sch(sch, block);   // compute the message schedule
    ihv = __f_loop(ihv, sch);    // run the main loop and update the IHVs
  }

  // now guaranteed to be at the last block
  // fill with zero-padding, leaving space for the length encoding
  while (i < 56) {
    block[u8 (int) i] = 0x0;
    i += 1;
  }

  // set the length encoding
  reg u64 bytes;
  bytes = bytes_st;
  bytes <<= 3; // convert message length (in bytes) to number of bits
  bytes = #BSWAP_64(bytes); // account for Little Endianness
  block[u64 (int) 7] = bytes; // byte index 7*8=56

  // process the block
  block = __swap_block(block); // swap every word to correct for Little Endianness
  sch = __f_sch(sch, block);   // compute the message schedule
  ihv = __f_loop(ihv, sch);    // run the main loop and update the IHVs

  return ihv;
}

// take the IHVs from the stack, and overwrite the hash value
inline fn __set_hash(stack u32[8] ihv, reg u64 hash) {
  reg u32 swap;
  inline int i;
  for i=0 to 8 {
    swap = ihv[i];
    swap = #BSWAP_32(swap); // account for Little Endianness in the ihvs
    (u32)[hash + 4*i] = swap;
  }
}

// take a byte sequence mess_addr with length bytes, and compute and store its hash value at hash_addr_in
inline fn __sha256_ref_alt(reg u64 hash_addr_in mess_addr bytes) {
  // store the parameter addresses on the stack
  stack u64 hash_addr_st; // hash address on the stack
  hash_addr_st = hash_addr_in;

  // initialise the IHVs on the stack
  stack u32[8] ihv;
  ihv = __init_ihv();

  // run the compression function, forming (padded) message blocks on the fly
  ihv = __f_comp(ihv, mess_addr, bytes);

  // store the resulting hash at the given memory address
  __set_hash(ihv, hash_addr_st);
}


























